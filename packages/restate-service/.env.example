# LLMs
GEMINI_API_KEY=your-gemini-api-key
# Optional. If set, OpenAI Responses API + web_search will also be queried per prompt.
OPENAI_API_KEY=

# Crawler selection: "jina" (default, recommended) or "cloudflare"
CRAWLER=jina

# Jina Reader: optional API key for higher rate limits
# Get a free key at https://jina.ai/reader/
JINA_API_KEY=

# Cloudflare /crawl: only needed if CRAWLER=cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token-with-browser-rendering-scope
